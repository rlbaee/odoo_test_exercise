<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="crm_lead_view_form_next_leads" model="ir.ui.view">
        <field name="name">crm.lead.form.next.leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Next Leads" name="next_leads">

                    <field name="next_lead_partner_ids">

                        <tree
                            decoration-info="next_lead_status == 'never'"
                            decoration-warning="next_lead_status == 'stale'"
                            create="false"
                            delete="false"
                            edit="false"
                        >
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="next_lead_status" column_invisible="1"/>

                            <button
                                name="action_create_next_lead"
                                type="object"
                                string="Create Lead"
                                icon="fa-plus"
                            />

                        </tree>

                    </field>

                </page>

            </xpath>

        </field>
    </record>

</odoo>
